# ===== Pulse for Nurses — .gitignore =====

# Book PDFs — protected IP, not needed at runtime.
# Keep these out of any public repo.
Book_PDF Copy/

# Copyrighted reference material (Cambridge IELTS books & audio) — NEVER publish.
IELTS Writing Evaluation Criteria/

# Personal files — not for the public repo.
Photoes_Pulse/
CV Sample*/
*.docx

# Local Claude Code dev config
.claude/

# OS metadata
.DS_Store
Thumbs.db
desktop.ini
ehthumbs.db

# Editor / IDE
.vscode/
.idea/
*.sublime-*
*.swp
*.swo
*~

# Local scratch / experimental notes
scratch/
*.local
*.tmp

# Local admin overrides exported by the panel (per-user content)
pulse-overrides*.json
overrides-*.json

# Node tooling (if you later add a build step)
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Logs
*.log

# Local reference docs (not for deploy)
Syllabus & Curriculum/
_syllabus/

# Google OAuth client secret downloads — NEVER commit
client_secret*.json
*client_secret*
