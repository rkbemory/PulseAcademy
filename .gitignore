# ===== Pulse for Nurses — .gitignore =====

# Book PDFs — protected IP, not needed at runtime.
# Keep these out of any public repo.
Book_PDF Copy/

# OS metadata
.DS_Store
Thumbs.db
desktop.ini
ehthumbs.db

# Editor / IDE
.vscode/
.idea/
*.sublime-*
*.swp
*.swo
*~

# Local scratch / experimental notes
scratch/
*.local
*.tmp

# Local admin overrides exported by the panel (per-user content)
pulse-overrides*.json
overrides-*.json

# Node tooling (if you later add a build step)
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Logs
*.log

# Local reference docs (not for deploy)
Syllabus & Curriculum/
